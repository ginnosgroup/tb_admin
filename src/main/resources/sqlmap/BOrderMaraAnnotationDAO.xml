<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.zhinanzhen.b.dao.OrderMaraAnnotationDAO">

    <resultMap id="orderMaraAnnotationResultMap" type="org.zhinanzhen.b.dao.pojo.OrderMaraAnnotationDO">
        <id property="id" column="id"/>
        <result property="gmtCreate" column="gmt_create"/>
        <result property="gmtModify" column="gmt_modify"/>
        <result property="serviceOrderId" column="service_order_id"/>
        <result property="maraMark" column="mara_mark"/>
        <result property="isCheck" column="is_check"/>
        <result property="checkTime" column="check_time"/>
        <result property="officialId" column="official_id"/>
    </resultMap>

    <insert id="add" parameterType="org.zhinanzhen.b.dao.pojo.OrderMaraAnnotationDO" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO b_order_mara_annotation (
            gmt_create,
            gmt_modify,
            service_order_id,
            mara_mark,
            is_check,
            check_time,
            official_id
        ) VALUES (
            now(),
            now(),
            #{serviceOrderId},
            #{maraMark},
            #{isCheck},
            #{checkTime},
            #{officialId}
        );
    </insert>

    <update id="update" parameterType="org.zhinanzhen.b.dao.pojo.OrderMaraAnnotationDO">
        UPDATE b_order_mara_annotation
        SET gmt_modify = now()
        <if test="maraMark != null">
            , mara_mark = #{maraMark}
        </if>
        <if test="isCheck != null">
            , is_check = #{isCheck}
        </if>
        <if test="checkTime != null">
            , check_time = #{checkTime}
        </if>
        <if test="officialId != null">
            , official_id = #{officialId}
        </if>
        WHERE service_order_id = #{serviceOrderId}
    </update>

    <select id="getByServiceOrderId" resultMap="orderMaraAnnotationResultMap">
        SELECT
            id,
            gmt_create,
            gmt_modify,
            service_order_id,
            mara_mark,
            is_check,
            check_time,
            official_id
        FROM b_order_mara_annotation
        WHERE service_order_id = #{serviceOrderId}
        LIMIT 1;
    </select>

</mapper>
